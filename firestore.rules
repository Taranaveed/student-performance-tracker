rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: is the caller authenticated? ─────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    // ── Helper: get the caller's profile from the users collection ────────────
    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // ── Helper: resolve the effective role ────────────────────────────────────
    // Supports both legacy single-role field and new roles[] array.
    // The active role is determined client-side and stored in activeRole on the
    // document; fall back to role for backward-compat.
    function callerRole() {
      let p = callerProfile();
      return p.get('activeRole', p.get('role', ''));
    }

    // ── Helper: roles with full institution-wide view ─────────────────────────
    // admin  → systemic access
    // peHead / skillsHead / activitiesHead → read-only global; write = domain-scoped
    function hasFullView() {
      return callerRole() in ['admin', 'peHead', 'skillsHead', 'activitiesHead'];
    }

    // ── Helper: only the Admin gets systemic write privileges ─────────────────
    function isAdmin() {
      return callerRole() == 'admin';
    }

    // ── User profiles ─────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:  if isAuth() && (request.auth.uid == userId || hasFullView());
      allow write: if isAuth() && request.auth.uid == userId;
    }

    // ── Legacy teachers collection ────────────────────────────────────────────
    match /teachers/{userId} {
      allow read:  if isAuth() && (request.auth.uid == userId || hasFullView());
      allow write: if isAuth() && request.auth.uid == userId;
    }

    // ── Students ──────────────────────────────────────────────────────────────
    match /students/{studentId} {
      allow read: if isAuth();

      allow create: if isAuth();

      // Only the teacher who created the student OR an admin can UPDATE/DELETE
      allow update, delete: if isAuth() &&
        (request.auth.uid == resource.data.teacherId || isAdmin());
    }

    // ── Performance logs ──────────────────────────────────────────────────────
    match /performance_logs/{logId} {
      allow read: if isAuth();

      // Any authenticated user can create/update logs (domain enforcement is
      // handled client-side via ROLE_SECTION_PERMISSIONS)
      allow create, update: if isAuth();

      // Only the creator OR an admin can delete
      allow delete: if isAuth() &&
        (request.auth.uid == resource.data.updatedBy || isAdmin());
    }
  }
}
